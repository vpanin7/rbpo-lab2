{
  "info": {
    "name": "РБПО, лаба 3 — коммунальные ресурсы",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Первая папка запускается на начальных данных один раз. Вторая создаёт отдельные записи и удаляет их."
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080"
    },
    {
      "key": "period",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date(); d.setUTCDate(1); d.setUTCMonth(d.getUTCMonth()-1);",
          "pm.collectionVariables.set(\"period\", d.toISOString().slice(0,7));"
        ]
      }
    }
  ],
